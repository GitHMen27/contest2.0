# =================================================================================================
# ШАБЛОН НАСТРОЕК ai-service
#
# Как пользоваться:
#   1. Скопируй этот файл в .env (рядом, в папке ai-service/):  Copy-Item .env.example .env
#   2. Впиши свои значения. Кавычки и пробелы вокруг "=" не нужны.
#   3. .env в .gitignore и никогда не должен попадать в git, в чат и в заметки.
#      В репозитории хранится только этот файл с пустыми значениями.
#
# Важно: переменная окружения (системная или заданная в терминале) ПЕРЕКРЫВАЕТ .env.
# Если поменял ключ, а ошибка осталась, запусти диагностику: она покажет перекрытие.
#   python check_db.py          база данных
#   python check_embeddings.py  эмбеддинги (Cloud.ru)
#   python check_chat.py        чат (Cloud.ru); python check_chat.py --list покажет доступные модели
#   python check_gigachat.py    GigaChat API Сбера (нужен только если выбран провайдер gigachat)
#
# Что за что отвечает (по умолчанию всё через один ключ Cloud.ru):
#   хранилище векторов             -> Postgres + pgvector (Neon)   раздел 1
#   вопросы и ответы модели (чат)  -> Cloud.ru Foundation Models   раздел 2
#   эмбеддинги для поиска          -> Cloud.ru Foundation Models   раздел 2
#   запасной вариант GigaChat      -> GigaChat API (Сбер)          раздел 3
#
# Обозначения:  [обязательно]  без этого сервис не запустится;  [необязательно]  есть значение по умолчанию.
# =================================================================================================


# -------------------------------------------------------------------------------------------------
# 1. БАЗА ДАННЫХ: PostgreSQL + pgvector (Neon)                                         [обязательно]
# -------------------------------------------------------------------------------------------------
# Neon -> проект -> Connect -> нужная ветка -> строка подключения целиком.
# В ветке должно быть расширение:  CREATE EXTENSION IF NOT EXISTS vector;
# Локальный вариант: postgresql://myuser:mypassword@localhost:5432/mydatabase
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require


# -------------------------------------------------------------------------------------------------
# 2. Cloud.ru Foundation Models: чат и эмбеддинги                                      [обязательно]
# -------------------------------------------------------------------------------------------------
# Cloud.ru -> Foundation Models -> API-ключи. Один ключ на чат и эмбеддинги. Одной строкой, без кавычек.
CLOUD_API_KEY=

# [необязательно] Адрес API. Значение ниже уже стоит по умолчанию.
# CLOUD_BASE_URL=https://foundation-models.api.cloud.ru/v1
# CLOUD_TIMEOUT=60

# --- Чат (ответы модели) ---
# cloudru   основной вариант
# gigachat  запасной (см. раздел 3)
LLM_PROVIDER=cloudru

# Точный id чат-модели из каталога Cloud.ru. Посмотреть доступные ключу:  python check_chat.py --list
# Регистр и префикс (например, vendor/model-name) важны: копируй как в списке.
CLOUD_CHAT_MODEL=

# --- Эмбеддинги (поиск по регламентам) ---
# cloudru   основной вариант: то, что проверяет test_cloud_embeddings.py
# gigachat  запасной (см. раздел 3)
EMBEDDING_PROVIDER=cloudru

# [необязательно] Модель эмбеддингов. Значение ниже уже стоит по умолчанию.
# CLOUD_EMBEDDING_MODEL=ai-sage/Giga-Embeddings-instruct-480M

# [необязательно] Инструкция для ВОПРОСОВ (instruct-модель лучше ищет, когда вопрос оформлен с инструкцией).
# К документам инструкция не добавляется. Пустое значение отключает её; переиндексация при смене не нужна.
# EMBEDDING_QUERY_INSTRUCTION=Given a question, retrieve passages that answer the question

# [необязательно] Размер вектора. НЕ УКАЗЫВАЙ: он определяется автоматически по ответу модели.
# Если сменил модель эмбеддингов:  python -m app.setup_db --recreate  и затем  python -m app.ingest
# EMBEDDING_DIM=


# -------------------------------------------------------------------------------------------------
# 3. GigaChat API (Сбер)                                                                [необязательно]
# Нужен только при LLM_PROVIDER=gigachat или EMBEDDING_PROVIDER=gigachat. Иначе оставь пустым.
# -------------------------------------------------------------------------------------------------
# Studio (developers.sber.ru) -> Проект GigaChat API -> Настройки API -> Получить ключ.
# Нужен именно «Ключ авторизации» (длинная base64-строка), а не Client ID и не Client Secret.
# Вставляй одной строкой, без кавычек, без пробелов и без слова Basic.
GIGACHAT_CREDENTIALS=

# Тип доступа должен совпадать с типом проекта, в котором создан ключ:
#   GIGACHAT_API_PERS  физические лица (самозанятые, ИП без договора)
#   GIGACHAT_API_B2B   юрлица, платные пакеты
#   GIGACHAT_API_CORP  юрлица, постоплата
# Если не совпадает, токен не выдаётся (ошибка 400). Проверка: python check_gigachat.py
# GIGACHAT_SCOPE=GIGACHAT_API_PERS

# GIGACHAT_MODEL=GigaChat-2
# GIGACHAT_EMBEDDING_MODEL=Embeddings
# GIGACHAT_TIMEOUT=60

# Сертификат «Russian Trusted Root CA» (gosuslugi.ru/crt), если не проходит проверка SSL.
# GIGACHAT_CA_BUNDLE_FILE=C:\certs\russian_trusted_root_ca.cer

# ТОЛЬКО для локальной разработки, если сертификат не настроен. На проде держи true.
# GIGACHAT_VERIFY_SSL_CERTS=false


# -------------------------------------------------------------------------------------------------
# 4. НАШ API (FastAPI): доступ с сайта и защита                                        [необязательно]
# -------------------------------------------------------------------------------------------------
# Какие сайты могут обращаться к API (через запятую, без пробелов и без слеша в конце).
# После деплоя фронтенда добавь его адрес с Vercel:
# CORS_ORIGINS=http://localhost:3000,https://your-site.vercel.app
CORS_ORIGINS=http://localhost:3000

# Для превью-деплоев Vercel, у которых адрес меняется (регулярное выражение):
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Ключ доступа к API. Если пусто, API открыт всем (только для разработки!).
# В продакшене задай длинную случайную строку; клиент передаёт её в заголовке X-API-Key.
# Сгенерировать:  python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=

# Сколько запросов в минуту разрешено с одного IP (защита ваших токенов и лимитов).
RATE_LIMIT_PER_MINUTE=30

# Папка с корпусом регламентов. По умолчанию ai-service/docs-corpus.
# DOCS_DIR=


# -------------------------------------------------------------------------------------------------
# Что ключей НЕ требует
# -------------------------------------------------------------------------------------------------
# Публичный OSRM (маршруты) и тайлы OpenStreetMap (карта) работают во фронтенде без ключей.
# Переменные фронтенда (адрес этого API) смотри в frontend/.env.example.
